<UserControl x:Class="SshBroker.Gui.SessionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.modernwpf.com/2019"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource InkBrush}" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel VerticalAlignment="Center">
      <Border CornerRadius="6" Background="{DynamicResource SoftBrush}" Padding="10,5" Margin="0,0,18,0"><TextBlock x:Name="StateValue" Text="{Binding View.State}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="HostValue" Text="{Binding View.Host}" FontWeight="SemiBold"/><TextBlock Text=":"/><TextBlock x:Name="PortValue" Text="{Binding View.Port}"/></StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="用户  " Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="UserValue" Text="{Binding View.Username}"/></StackPanel>
     </WrapPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="RX " Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding View.RxBytes}" FontFamily="Consolas" Margin="0,0,20,0"/>
      <TextBlock Text="TX " Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding View.TxBytes}" FontFamily="Consolas"/>
      <TextBlock x:Name="RevisionValue" Text="{Binding View.Revision}" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding View.Error}" Foreground="#BB414C" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="324"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="20,18,20,10"><TextBlock Text="连接设置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="配置当前标签对应的远端设备" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,18,10">
      <StackPanel>
       <TextBlock Text="设备名称 / 备注" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" TextChanged="NameEdited" LostFocus="NameLostFocus"/>
       <StackPanel x:Name="ConnectionFields">
        <TextBlock Text="IP / 域名 · 可选择历史记录" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HostBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Host" DisplayMemberPath="Display" SelectionChanged="HistorySelected"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="SSH 端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PortBox" TextChanged="DraftChanged"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UserBox" TextChanged="DraftChanged"/></StackPanel>
        </Grid>
        <TextBlock Text="认证方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AuthBox" SelectedValuePath="Tag" SelectionChanged="AuthChanged"><ComboBoxItem Tag="password" Content="密码"/><ComboBoxItem Tag="key" Content="私钥文件"/></ComboBox>
        <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"/>
        <Expander Header="高级认证与服务器身份" Margin="0,12,0,0"><StackPanel Margin="0,4,0,8">
         <TextBlock Text="私钥路径" Style="{StaticResource FieldLabel}"/><TextBox x:Name="KeyBox" TextChanged="DraftChanged"/>
         <TextBlock Text="私钥口令（可选）" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PassphraseInput" PasswordChanged="PasswordChanged"/>
         <TextBlock Text="受信任主机指纹" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FingerprintBox" TextChanged="DraftChanged"/>
         <TextBlock Text="观测指纹" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding View.Fingerprint, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
         <Button Content="核对后使用此指纹" Click="TrustFingerprintClick" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel></Expander>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,14,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
         <CheckBox x:Name="TelnetEnabledBox" Content="本机 Telnet" VerticalAlignment="Bottom" Margin="0,0,0,5" Checked="DraftChanged" Unchecked="DraftChanged"/>
         <StackPanel Grid.Column="2"><TextBlock Text="Telnet 端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TelnetPortBox" TextChanged="TelnetPortEdited"/></StackPanel>
        </Grid>
       </StackPanel>
       <TextBlock Text="日志根目录" Style="{StaticResource FieldLabel}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
        <TextBox x:Name="LogRootBox" TextChanged="DraftChanged" ToolTip="日志根目录"/>
        <Button Grid.Column="2" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Padding="0" ToolTip="打开日志文件夹" Click="OpenLogFolderClick"/>
       </Grid>
       <TextBlock Text="PTY 尺寸 · 列 × 行" Style="{StaticResource FieldLabel}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="ColumnsBox"/><TextBox x:Name="RowsBox" Grid.Column="2"/><Button Grid.Column="4" Content="更新" Click="ResizeClick" Padding="12,5"/>
       </Grid>
       <TextBlock x:Name="DraftLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"/>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="ApplyButton" Content="应用配置" Click="ApplyClick"/>
       <Button x:Name="ConnectButton" Grid.Column="2" Content="连接 SSH" Style="{StaticResource PrimaryButton}" Click="ConnectClick"/>
       <Button Grid.Row="1" Content="断开" Click="DisconnectClick" Style="{StaticResource QuietButton}" Margin="0,6,0,0"/>
       <Button Grid.Row="1" Grid.Column="2" Content="重新连接" Click="ReconnectClick" Style="{StaticResource QuietButton}" Margin="0,6,0,0"/>
      </Grid>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="18,14">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal"><TextBlock Text="协作会话" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{Binding View.Writer, StringFormat=写入者  {0}}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
       <ComboBox x:Name="PolicySelector" Grid.Column="1" Width="204" SelectedValuePath="Tag" SelectedValue="{Binding View.Policy, Mode=OneWay}" SelectionChanged="PolicyChanged">
        <ComboBoxItem Tag="shared" Content="共享写入（默认）"/><ComboBoxItem Tag="single" Content="单写入者"/><ComboBoxItem Tag="readonly" Content="全部只读"/>
       </ComboBox>
      </Grid>
      <DataGrid Grid.Row="1" SizeChanged="ClientsGridSizeChanged" ItemsSource="{Binding View.Clients}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" RowHeight="30" ColumnHeaderHeight="30" MinHeight="52" MaxHeight="110" Margin="0,8,0,0" FontSize="12">
       <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{DynamicResource CardBrush}" Padding="10,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.ColumnHeaderStyle>
       <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/></Style></DataGrid.CellStyle>
       <DataGrid.Columns><DataGridTextColumn Header="客户端" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90"/><DataGridCheckBoxColumn Header="可写" Binding="{Binding CanWrite}" Width="64"/><DataGridTextColumn Header="已发送 / B" Binding="{Binding TxBytes}" Width="90"/></DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="终端监视" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="PaletteBox" Visibility="Collapsed" Width="125" SelectionChanged="PaletteChanged"/><CheckBox x:Name="PauseBox" Content="暂停" Margin="14,0" VerticalAlignment="Center"/><Button Content="清空" Click="ClearClick" Style="{StaticResource QuietButton}" Padding="10,4"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="10,0,10,10" CornerRadius="10" Background="{Binding Background, ElementName=MonitorBox}">
       <TextBox x:Name="MonitorBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111A26" Foreground="#D6E2EE" BorderThickness="0" Padding="14" VerticalContentAlignment="Top" ui:ControlHelper.CornerRadius="10"/>
      </Border>
     </Grid>
    </Border>
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SendBox" MinWidth="180" ToolTip="向当前目标发送命令或字节"/>
      <Button Grid.Column="2" Content="发送  ↵" Click="SendClick" Style="{StaticResource PrimaryButton}"/>
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"><CheckBox x:Name="CrBox" Content="追加 CR" IsChecked="True" Margin="0,0,18,0"/><CheckBox x:Name="HexBox" Content="十六进制"/><TextBlock Text="{Binding View.LogDirectory, StringFormat=日志  {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="16,3,0,0" MaxWidth="340" TextTrimming="CharacterEllipsis"/></WrapPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="4,10,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="就绪"/>
  </Grid>
 </Grid>
</UserControl>
