<Window x:Class="SshBroker.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SshBroker — 共享 SSH 会话与自动化控制" Width="1240" Height="860" MinWidth="1060" MinHeight="680" FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F5F7">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="14" Background="White" CornerRadius="5" Margin="0,0,0,14">
   <StackPanel>
    <DockPanel><TextBlock Text="SSH Broker" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PipeLabel" HorizontalAlignment="Right" Foreground="#596579"/></DockPanel>
    <WrapPanel Margin="0,10,0,0">
     <TextBlock Text="状态："/><TextBlock x:Name="StateValue" Text="{Binding View.State}" FontWeight="Bold" Margin="0,0,18,0"/>
     <TextBlock Text="目标："/><TextBlock x:Name="HostValue" Text="{Binding View.Host}"/><TextBlock Text=":"/><TextBlock x:Name="PortValue" Text="{Binding View.Port}" Margin="0,0,18,0"/>
     <TextBlock Text="用户："/><TextBlock x:Name="UserValue" Text="{Binding View.Username}" Margin="0,0,18,0"/>
     <TextBlock Text="revision："/><TextBlock x:Name="RevisionValue" Text="{Binding View.Revision}" Margin="0,0,18,0"/>
     <TextBlock Text="RX："/><TextBlock Text="{Binding View.RxBytes}" Margin="0,0,12,0"/><TextBlock Text="TX："/><TextBlock Text="{Binding View.TxBytes}"/>
    </WrapPanel>
    <TextBlock Text="{Binding View.Error}" Foreground="#A22B29" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" Padding="14" CornerRadius="5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="SSH 配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,9"/>
      <StackPanel x:Name="ConnectionFields">
       <TextBlock Text="主机"/><TextBox x:Name="HostBox" TextChanged="DraftChanged"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="SSH 端口"/><TextBox x:Name="PortBox" TextChanged="DraftChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="用户名"/><TextBox x:Name="UserBox" TextChanged="DraftChanged"/></StackPanel>
       </Grid>
       <TextBlock Text="认证方式"/><ComboBox x:Name="AuthBox" SelectedValuePath="Tag" SelectionChanged="AuthChanged"><ComboBoxItem Tag="password" Content="密码"/><ComboBoxItem Tag="key" Content="私钥文件"/></ComboBox>
       <TextBlock x:Name="PasswordLabel" Text="密码（留空保留内存中的凭据）"/><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"/>
       <Expander Header="高级：私钥与服务器身份" Margin="0,4,0,4"><StackPanel>
       <TextBlock Text="私钥路径（仅私钥认证使用）"/><TextBox x:Name="KeyBox" TextChanged="DraftChanged"/>
       <TextBlock Text="私钥口令（可选）"/><PasswordBox x:Name="PassphraseInput" PasswordChanged="PasswordChanged"/>
       <TextBlock Text="受信任主机指纹（SHA256:...）"/><TextBox x:Name="FingerprintBox" TextChanged="DraftChanged"/>
       <TextBlock Text="观测指纹（先与管理员核对，再填写）" Foreground="#596579"/>
       <TextBox Text="{Binding View.Fingerprint, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
       <Button Content="核对后使用此指纹" Click="TrustFingerprintClick" HorizontalAlignment="Left"/>
       </StackPanel></Expander>
       <TextBlock Text="密码登录只需填写主机、用户名和密码。首次连接确认服务器身份后自动记住。" TextWrapping="Wrap" Foreground="#596579"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="TelnetEnabledBox" Content="启用本机 Telnet" VerticalAlignment="Center" Checked="DraftChanged" Unchecked="DraftChanged"/>
        <StackPanel Grid.Column="2"><TextBlock Text="Telnet 端口"/><TextBox x:Name="TelnetPortBox" TextChanged="DraftChanged"/></StackPanel>
       </Grid>
       <TextBlock Text="日志根目录"/><TextBox x:Name="LogRootBox" TextChanged="DraftChanged"/>
      </StackPanel>
      <TextBlock x:Name="DraftLabel" Foreground="#596579" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <WrapPanel><Button x:Name="ApplyButton" Content="应用配置" Click="ApplyClick"/><Button x:Name="ConnectButton" Content="连接 SSH" Click="ConnectClick"/><Button Content="断开" Click="DisconnectClick"/><Button Content="重连" Click="ReconnectClick"/></WrapPanel>
      <TextBlock Text="PTY 尺寸（所有客户端共用）"/>
      <WrapPanel><TextBox x:Name="ColumnsBox" Width="64"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="RowsBox" Width="64"/><Button Content="更新尺寸" Click="ResizeClick" Margin="10,0,0,0"/></WrapPanel>
      <TextBlock Text="配置在应用后成为权威状态；CLI 的配置修改会同步刷新这些字段。密码只留在内存，不从 API 读回。" TextWrapping="Wrap" Foreground="#596579"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <TextBlock Text="写入策略" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <ComboBox x:Name="PolicySelector" Width="310" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding View.Policy, Mode=OneWay}" SelectionChanged="PolicyChanged">
      <ComboBoxItem Tag="shared" Content="共享写入（默认）"/><ComboBoxItem Tag="single" Content="单写入者（首个发送者独占）"/><ComboBoxItem Tag="readonly" Content="全部只读"/>
     </ComboBox>
     <TextBlock Text="{Binding View.Writer, StringFormat=当前写入者：{0}}" VerticalAlignment="Center" Margin="15,0,0,0"/>
    </DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding View.Clients}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="White">
     <DataGrid.Columns><DataGridTextColumn Header="会话" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80"/><DataGridCheckBoxColumn Header="可写" Binding="{Binding CanWrite}" Width="65"/><DataGridTextColumn Header="TX 字节" Binding="{Binding TxBytes}" Width="100"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,12,0,4"><TextBlock Text="RX / TX / 事件" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="PauseBox" Content="暂停显示" Margin="12,4,12,0"/><Button Content="清空显示" Click="ClearClick" Margin="0"/></StackPanel></DockPanel>
    <TextBox x:Name="MonitorBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111A26" Foreground="#D6E2EE"/>
    <StackPanel Grid.Row="4">
     <DockPanel><TextBox x:Name="SendBox" MinWidth="200" DockPanel.Dock="Left"/><Button Content="发送" Click="SendClick" Margin="10,3,0,8"/></DockPanel>
     <WrapPanel><CheckBox x:Name="CrBox" Content="追加 CR" IsChecked="True" Margin="0,0,18,0"/><CheckBox x:Name="HexBox" Content="十六进制输入"/></WrapPanel>
     <TextBlock Text="{Binding View.LogDirectory, StringFormat=日志：{0}}" TextWrapping="Wrap" Foreground="#596579" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
  <TextBlock x:Name="StatusLabel" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#35435A" Text="准备就绪。MobaXterm 使用本机 Telnet，Agent 使用 sshctl。"/>
 </Grid>
</Window>
