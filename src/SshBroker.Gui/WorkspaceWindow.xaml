<Window x:Class="SshBroker.Gui.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.modernwpf.com/2019"
 Icon="Assets/SshBroker.ico" Title="SSH Broker · 多设备工作区" Width="1380" Height="960" MinWidth="1120" MinHeight="760" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource InkBrush}" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" ui:WindowHelper.UseModernWindowStyle="True">
 <Grid Margin="24,12,24,14" Background="{DynamicResource CanvasBrush}" TextElement.Foreground="{DynamicResource InkBrush}">
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="Assets/SshBroker.png" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="SSH Broker" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Border Background="{DynamicResource SoftBrush}" CornerRadius="5" Margin="14,0,0,0" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="WORKSPACE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/></Border>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="帮助" Style="{StaticResource QuietButton}" Click="HelpClick" Margin="0,0,16,0"/><TextBlock Text="外观" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="GlobalThemeBox" Width="116" SelectedValuePath="Tag" SelectionChanged="GlobalThemeChanged"><ComboBoxItem Tag="Light" Content="明亮"/><ComboBoxItem Tag="Dark" Content="暗色"/><ComboBoxItem Tag="Warm" Content="暖色"/><ComboBoxItem Tag="Blue" Content="淡蓝"/></ComboBox></StackPanel>
  </Grid>
  <TabControl x:Name="SessionTabs" Grid.Row="1">
   <TabItem x:Name="WelcomeTab">
    <TabItem.Header><Button Content="＋ 新建连接" Click="NewClick" Style="{StaticResource QuietButton}" MinHeight="24" Padding="0"/></TabItem.Header>
    <Grid TextElement.Foreground="{DynamicResource InkBrush}">
     <Border Style="{StaticResource Card}" Padding="48" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
       <Border Background="{DynamicResource SoftBrush}" CornerRadius="14" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock Text="&gt;_" FontSize="25" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock Text="连接你的开发环境" FontSize="32" FontWeight="SemiBold"/>
       <TextBlock Text="从虚拟机到开发板，在一个工作区中轻松切换。" FontSize="15" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,32"/>
       <Grid Margin="0,0,0,30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="独立连接，共享终端" FontWeight="SemiBold"/><TextBlock Text="多个远端设备同时在线，每个目标保留独立的连接与会话。" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="记住设备，不记住密码" FontWeight="SemiBold"/><TextBlock Text="地址、名称与连接偏好自动保留，认证凭据不写入历史记录。" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
       </Grid>
       <Button Content="＋  新建 SSH 连接" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="NewClick" Padding="22,10" Height="44"/>
       <TextBlock x:Name="WelcomeHistory" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,22,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="WorkspaceStatus" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,12,0,0" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>
